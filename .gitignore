# GitFast Production .gitignore
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Build & Dependency directories
node_modules/
dist/
build/
out/
.next/
.turbo/
.cache/
coverage/

# Environment variables & secrets
.env
.env*.local
*.pem
*.key
credentials.json
id_rsa
id_ed25519

# Python & Virtual Envs
venv/
.venv/
__pycache__/
*.pyc

# Operating System & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
